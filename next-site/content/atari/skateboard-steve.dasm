;------------------------------------------------
	processor 	6502
	include 	vcs.h
	include 	macro.h

;------------------------------------------------
; Constants
;------------------------------------------------

;***** COLORS
BACKGROUND_COLOR 	= #$AC								; Used for the background
CANYON_WALLS_COLOR 	= #$24								; Used for the canyon walls
;CANYON_WALLS_COLOR 	= #$F0								; Used for the canyon walls
CANYON_GROUND_COLOR = #$C0								; Used for the bottom of the canyon

FENCE_COLOR			= #$0E
HOUSE_COLOR			= #$24
ROOF_COLOR			= #$42

;***** PLAYFIELD STUFF
CANYON_WALL 		= #%00110000						; Playfield pattern for pf0
CANYON_GROUND 		= #%11111111						; Playfield pattern for pf1
CANYON_CTLPF 		= #%00000001						; Setting the playfield to reflect
HOUSE_WALL	 		= #%11110000						; Playfield pattern for pf0
HOUSE_WALL2	 		= #%11000000						; Playfield pattern for pf0

;***** BALL
PF_BALL_SIZE4 		= %00110000							; BALL SIZE 4
BALL_ENABLE_MASK	= %00000010							; Ball Enabled
BALL_DISABLE_MASK	= %00000000							; Ball Disabled
ROCK_HEIGHT			= #19								; Height of the Rock

;***** PLAYER ONE COLORS
P0_HAT = #$40
P0_SKIN = #$FB
P0_SHIRT = #$80
P0_PANTS = #$1F
P0_SHOES = #$00


;***** PLAYER TWO COLORS
P1_SKIN = #$FB
P1_BEARD = #$05
P1_SHIRT = #$C0
P1_PANTS = #$F0


P_MIRROR 				= #%00001000					; Will mirror the player one graphics
P0_MOVE_LEFT 			= #$20							; Left movement speed
P0_MOVE_RIGHT		 	= #$E0							; Right movement speed

;***** PLAYER TWO COLORS
P1_SKIN 				= #$FB
P1_BEARD 				= #$05
P1_SHIRT 				= #$C0
P1_PANTS 				= #$F0



;***** SCORE
SCORE_COLOR 			= #$28							; Color of the score

;***** MISSILES
MISSILE_ENABLE_MASK 	= %00000010						; Enable the missile mask
MISSILE_DISABLE_MASK 	= %00000000						; Disable the missile mask
MISSILE_HEIGHT			= #20							; Length of Missile

;------------------------------------------------
;CONTROLS
;------------------------------------------------
P0_RIGHT 	= #%10000000 								;--Player 0 hits right
P0_LEFT 	= #%01000000 								;--Player 0 hits left
P0_DOWN 	= #%00100000 								;--Player 0 hits down
P0_UP 		= #%00010000 								;--Player 0 hits up
PLAYER_ONE_MOVE_LEFT = #$20								; Left movement speed
PLAYER_ONE_MOVE_RIGHT = #$E0						; Right movement speed


P1_RIGHT 	= #%00001000 								;--Player 1 hits right
P1_LEFT		= #%00000100 								;--Player 1 hits left
P1_DOWN		= #%00000010 								;--Player 1 hits down
P1_UP 		= #%00000001 								;--Player 1 hits up
P1_FIRE		= #%01000000 								;--Player 1 hits fire
PLAYER_TWO_MOVE_LEFT = #$10								; Left movement speed
PLAYER_TWO_MOVE_RIGHT = #$F0							; Right movement speed


; mask for SWCHB
P1_DIFF_MASK      = %10000000
BW_MASK           = %00001000       					; black and white bit
SELECT_MASK       = %00000010							; Select
RESET_MASK        = %00000001							; Reset

;------------------------------------------------
;Music Notes
;------------------------------------------------
NOTE_E = 23
NOTE_F = 20												; Not good
NOTE_G = 19
NOTE_GS = 18
NOTE_A = 17
NOTE_B = 15
NOTE_C = 14
NOTE_D = 12
NOTE_E2 = 11
NOTE_D2 = 26

;These notes signal the start of a note
NOTEA_E = 23+32
NOTEA_F = 20+32											; Not good
NOTEA_G = 19+32
NOTEA_GS = 18+32
NOTEA_A = 17+32
NOTEA_B = 15+32
NOTEA_C = 14+32
NOTEA_D = 12+32
NOTEA_E2 = 11+32
NOTEA_D2 = 26+32



;------------------------------------------------
; RAM
;------------------------------------------------
    SEG.U   variables
    ORG     $80
;--Our actual score
score0				.byte
loopcounter 		.byte
frameCount			.byte
scoreLine			.byte
;--Character 1 address start
starting_x_value_lo .byte
starting_x_value_hi .byte
yPos				.byte
lineCount			.byte
airCount			.byte
groundCount			.byte
rockCount			.byte
frames				.byte
p1_fire				.byte
;visiblePlayerLine	.byte

;***** PLAYER POSITION VARIABLES
p0HorPos			.byte						; Flag to determine which way the player is pressing. 1 == left, 0 == rights
isP0PFCollision 	.byte						; Flag for if there is a collision with the playfield. 1 == Yes a collision, 0 == no collision
p0CanMove			.byte						; Flag to check if input is allowed again. 1 == Can move, 0 == Cant move


	
;------------------------------------------------
; Start of ROM
;------------------------------------------------
	SEG   Bank0
	ORG   $F000       	; 4k ROM start point
	
Start 
	CLEAN_START			; Clear RAM and Registers
	;Initialize variables
	lda 	#12									; Audio Vals
	sta 	AUDC0								; Audio channel
	
	lda		#192
	sta		yPos
		
	lda		#0									; Start score at 9?
	sta		score0								; Store to score

	
	
	lda		#0									; Load 0 into A
	sta		starting_x_value_lo					; High 0
	sta		starting_x_value_hi					; Low 0
	sta		frameCount							; Start frameCount
	sta		p0HorPos
	
	lda		#1
	sta		p0CanMove							; Setting the movement flag to true to start with
	
	lda		#BACKGROUND_COLOR					
	sta		COLUBK								; Setting the color for the background
	
	lda		#CANYON_CTLPF | PF_BALL_SIZE4		; Also set the ballsize
	sta		CTRLPF								; Setting the reflection pattern for the playfield
	
	lda		#CANYON_WALLS_COLOR					; Color player0 and player 1 the canyon
	sta		COLUP0
	sta		COLUP1
	
	lda		#BALL_ENABLE_MASK	
	sta		ENABL								; Enable the ball

	sta		RESM0	
	sta		RESM1

	;---------------------------------------------
	; MISSILE.dasm
	;---------------------------------------------
	lda #2										;	
	sta ENAM0  									;enable it
	lda #33
	sta COLUP0 									;color it [actually setting player 1 color, which missile 1 matches]
	lda #$20
	sta NUSIZ0									;make it quadwidth (not so thin, that)
	lda #$10									; -1 in the left nibble
	;sta HMBL									; of HMM1 sets it to moving
	sta HMM0									; of HMM1 sets it to moving
	;---------------------------------------------
	;NUSIZ0										; Width of a missile is controlled by writing into bits 
	;NUSIZ1										; D4 and D5 of the number-size registers (NUSIZ0, NUSIZ1)
	
	;---------------------------------------------
	; MISSILE.dasm
	;---------------------------------------------
	lda #2										;	
	sleep 6
	sta	RESP1
	;sta ENAM1  								; enable it
	;lda #33
	;sta COLUP1 								; color it [actually setting player 1 color, which missile 1 matches]
	lda #$20
	
	;sta NUSIZ1									; make it quadwidth (not so thin, that)
	lda #$FF									; -1 in the left nibble
	;sta HMBL									; of HMM1 sets it to moving
	sta HMM1									; of HMM1 sets it to moving

	;---------------------------------------------
	lda 	#%00110000									; quad width
	sta 	NUSIZ0										; Width of a missile is controlled by writing into bits 
	sta 	NUSIZ1										; D4 and D5 of the number-size registers (NUSIZ0, NUSIZ1)
	

	

;------------------------------------------------
; Vertical Blank
;------------------------------------------------
MainLoop
	lda		#CANYON_WALLS_COLOR												; Load canyon color
	sta		COLUPF															; color the playfield
	lda		#0									; Set volume to 0
	;sta	AUDV0							; TIA volume flag
	sta		VBLANK								; No idea
	
	VERTICAL_SYNC
    lda     #43
    sta     TIM64T
	lda 	#2
	;lda 	#$0									; Stop it from moving
	;sta 	HMBL								; Send to TIA


	;***** Vertical Blank code goes here
	;--------------------------------------------
	; PLAYER ZERO CONTROL
	;--------------------------------------------
	dec		yPos
	sta		CXCLR								; Clearing collision detection register
	
	lda		#1
	cmp		isP0PFCollision						; Checking against the playfield collision flag
	beq		.collidingWithPlayfield				; If it is colliding, no input is allowed
	
	ldy		#0
	
	lda		#P0_LEFT							; CHECKING IF MOVING LEFT
	bit		SWCHA		
	bne		.checkP0RightMove					; IF NOT, CHECK RIGHT MOVEMENT

	lda		#1
	cmp		p0CanMove
	beq		.moveP0Left							; If the player is allowed to move, branch to the movement section
	cmp		p0HorPos
	bne		.moveP0Left							; Determine if the input is acceptable input after the collision
	
	jmp		.doneCheckingPlayerInput			; If not, don't let the player move

.moveP0Left
	lda		#1									; Setting p1HorPos to 1
	sta		p0HorPos							; If it's set to one, it will adjust the player to the right after a collision
	ldy		#P0_MOVE_LEFT						; Setting the movement offset to the left movement value
	lda		#1
	sta		p0CanMove							; Resetting the can move flag

	lda		#P_MIRROR							; Since moving left, reflect the player image
	sta		REFP0								; Reflecting
	jmp		.doneCheckingPlayerInput			; Skip to being done

.checkP0RightMove
	lda		#P0_RIGHT							; Checking if moving right
	bit		SWCHA								; Against the joystick input
	bne		.doneCheckingPlayerInput			; If not, we're done checking input

	lda		#1
	cmp		p0CanMove
	beq		.moveP0Right						; If the player is allowed to move, branch to the movement section

	cmp		p0HorPos
	beq		.moveP0Right						; Determine if the input is acceptable input after the collision

	jmp		.doneCheckingPlayerInput			; If not, don't let the player move

.moveP0Right
	lda		#0									; Setting p1HorPos to 0
	sta		p0HorPos							; If it's set to 0, it will adjust the player to the left after a collision
	ldy		#P0_MOVE_RIGHT				; Setting the movement offset to the right movement value

	lda		#1
	sta		p0CanMove							; Resetting the can move flag

	lda		#0									; Cancelling the reflection
	sta		REFP0								; Which will turn the player back
	jmp		.doneCheckingPlayerInput			; Skip to being done

.collidingWithPlayfield
	lda		#0									
	cmp		p0HorPos							; Checking to see which way the player was moving
	beq		.adjustP0Right						; Branching to adjust the player to the right a bit if they were moving left

	ldy		#P0_MOVE_RIGHT

	jmp		.doneCheckingPlayerInput

.adjustP0Right
	ldy		#P0_MOVE_LEFT

.doneCheckingPlayerInput
	sty		HMP0								; Storing how much to move by

	;--------------------------------------------
	; PLAYFIELD CANYON WALLS
	;--------------------------------------------
	inc		frameCount							; increment the frameCounter
	lda		frameCount							; Load it to A
	cmp		#50									; Compare with 50
	beq		.incrementScore						; if equal, increment score
	jmp		.dontIncrement						; if not, dont increment

.incrementScore									;--Increment the score
	lda		#0									; Reset Frame Count
	sta		frameCount							; Store 0 in frame count
	clc											; Clear the carry
	sed											; Set decimal mode
	lda		score0								; Load Score
	adc		#1									; Add one to A
	sta		score0								; Store A in score
	cld											; Clear Decimal mode
	
	lda	score0									;--Calculate starting_x_value for the
	and	#%00001111								;  low bits of score0
												;Store the current score
	sta	starting_x_value_lo						; This
	asl											; Shift Left [Multiply x2]
	asl											; Shift Left [Multiply x2]
	
	clc											; Clear the carry
	adc	starting_x_value_lo						; Add the starting value [Add it once more]
	sta	starting_x_value_lo						; Store
	
												;--Calculate starting x for the hi bits
	lda	score0									; High score
	
												;Shift the 4 hi bits to the right, 4 places
	lsr											; Forgot what this does
	lsr											; Forgot what this does
	lsr											; Forgot what this does
	lsr											; Forgot what this does

	sta	starting_x_value_hi						;Store the current score			
	clc
	asl											; Shift Left [Multiply x2]
	asl											; Shift Left [Multiply x2]
	
	clc											; Clear the carry
	adc	starting_x_value_hi						; Add the starting value [Add it once more]
	sta	starting_x_value_hi						; Store

.dontIncrement
	;--------------------------------------------
	; PLAYER TWO CONTROL
	;--------------------------------------------
	sta		CXCLR								; Clearing collision detection register
	ldy		#0
	
	lda		#P1_LEFT							; CHECKING IF MOVING LEFT
	bit		SWCHA		
	bne		.checkP1RightMove					; IF NOT, CHECK RIGHT MOVEMENT
	
	ldy		#PLAYER_TWO_MOVE_LEFT				; Setting the movement offset to the left movement value
		
	lda		#P_MIRROR					; Since moving left, reflect the player image
	sta		REFP1								; Reflecting
	jmp		.doneCheckingP1Input				; Skip to being done
	
.checkP1RightMove
	lda		#P1_RIGHT							; Checking if moving right
	bit		SWCHA								; Against the joystick input
	bne		.doneCheckingP1Input				; If not, we're done checking input
	
	ldy		#PLAYER_TWO_MOVE_RIGHT				; Setting the movement offset to the right movement value
	
	lda		#0									; Cancelling the reflection
	sta		REFP1								; Which will turn the player back
	jmp		.doneCheckingP1Input				; Skip to being done

	
.doneCheckingP1Input
	sty		HMP1								; Storing how much to move by
	sty		HMBL


.player1Right
	lda 	SWCHA								; Load Joysticks
	and 	#P1_RIGHT 							; Player 1 hits right
	bne		.player1Left						; If not jump to left
	clc											; Clear the carry
	lda		#$FF								; Move right
	;sta		HMBL								; Tell TIA
	lda		NOTE_C								; Play C
	sta 	AUDF0								; 
	lda		#$1									; 
	sta		AUDV0								;
	jmp		.player1End
.player1Left
	lda 	SWCHA								; Load Joysticks
	and 	#P1_LEFT							;--Player 1 hits left
	bne		.player1Fire							; If not jump to down
	clc											
	lda		#$10								; Move left
	;sta		HMBL								; Tell TIA
	lda		NOTE_D								; Play D
	sta 	AUDF0								;
	lda		#$1									;
	sta		AUDV0								;
	jmp		.player1End							; Jump to the end
.player1Fire
	lda		SWCHA									; Load Joysticks
	and		P1_DOWN								; Player 1 hits down
	;lda	INPT5
	;and	P1_FIRE
	bne		.player1NoMovementEnd							; branch to player1End if not pressed down
	lda		NOTE_B								; Load Note_B
	sta 	AUDF0								; Notify TIA
	lda		#$1									; Load into A
	sta		AUDV0								; Store volume to TIA
	lda		#1									; Load 1 into A
	sta		p1_fire								; Set the flag that he fired
	jmp		.player1End

.player1NoMovementEnd
	lda		#$0									; Load into A
	sta		AUDV0								; Store volume to TIA	

.player1End


.waitForVBlank
	lda		INTIM						;
	bne		.waitForVBlank				;
	sta		WSYNC						; 
	sta		HMOVE						; Allow for movement

;------------------------------------------------
; Kernel
;------------------------------------------------	

DrawScreen
	inc		frames
	ldx		#192+1
	stx		lineCount
	ldx		#132+1															; This is how many lines of air we have
	stx		airCount														; store it into the variable
	ldx		#9																; 9 lines of ground
	stx		groundCount														; Update ground count
	lda		#0																; Empty pf1, pf2, pf0
	sta		PF0																;
	sta 	PF1																;
	sta		PF2																;
	sta		GRP1															; BURT
	lda		#5																;
	sta		loopcounter														;
	ldx		starting_x_value_lo												;
	lda		.zero_right,x													;
	ldy		starting_x_value_hi												;
	ora 	.zero_left,y													;
.scoreloop	
	sta		PF1				
	sta		scoreLine
	;lda	#0																; Uncommenting gets rid of the second one
	;sta	PF1																; Uncommenting gets rid of the second score
	sta 	WSYNC
																			;----------------------------------------
																			; This is where we empty the second score 
																			;----------------------------------------
	sta 	WSYNC															; Draw line
	inx																		; Increment X
	iny																		; Increment Y
	lda		.zero_right,x													; 
	ora 	.zero_left,y													;
	sta		PF1																;
	
	dec 	loopcounter
	bne		.scoreloop
	lda		#0
	sta		PF1
	
	ldx		#5																; 5 WSYNCS
.tempLoop
	dec		lineCount														; Decrement Line Count
	dex																		; Dec X
	sta		WSYNC															; Draw Line
	bne		.tempLoop														; Loop
	

	;------------------------------------------------
	; Player 1 Level
	;------------------------------------------------
	ldx		#7										; Loading the sprite array index
	sta		WSYNC
.p1DrawLoop											; This loop will loop through 16 total lines
	lda		.p1SpriteColors,x						; Getting the sprite color
	sta		COLUP1									; Storing to the p1 color register

	lda		.p1Sprite,x								; Getting the graphics data
	sta		GRP1									; Saving to the player 1 graphics

	; 26 pixels left before visible

	sta		WSYNC									; Waiting for the next line
	sta		WSYNC									; Elongating the draw

	dex												; Checking to see if we are done looping
	bpl		.p1DrawLoop

	sta		WSYNC									; Elongating the last draw
	lda		#0										; Stopping the player 1 drawing
	sta		GRP1
	
.house
	lda		#0
	sta		PF0
	sta		PF1
	sta		PF2
	sta		GRP1
	sleep 4
	lda		#HOUSE_WALL
	sta		PF0
	lda		#HOUSE_WALL2
	;ora		#%11000000
	sta		PF1
	
.dropBall																	; DROP THE BALL
	lda		lineCount														; load lineCount
	sbc		yPos															; Subtract the yPositionFromBottom
	adc		#ROCK_HEIGHT													; Add the Rock_Height [19]
	bcs		.enableBall														; If the carry flag is set, jump to the enable ball
	lda		BALL_DISABLE_MASK												; Disable ball
	sta		ENABL															; Send disable to TIA
	sta		ENAM1
	sta		ENAM0
	jmp		.openAir														; jmp to the background
	
.enableBall
	lda 	#$24
	sta 	COLUP0						 									;color it [actually setting player 1 color, which missile 1 matches]
	sta 	COLUP1
	lda		BALL_ENABLE_MASK												; Enable the ball
	sta		ENABL															; Send enable to TIA
	sta		ENAM1
	sta		ENAM0

.openAir
	dec		lineCount														; Decrement Line Count
	dec		airCount														; Decrement Air Count
	;beq		.door
	sta		WSYNC															; Draw Line
	bne		.house															; Loop
	

	;------------------------------------------------
	; Player Zero Level
	;------------------------------------------------
	lda		#0
	sta		PF0
	sta		PF1
	ldx		#7
	sta		WSYNC
	
.p0DrawLoop																	; This loop will loop through 16 total lines									; Decrementing the array index
	lda		#FENCE_COLOR
	sta		COLUPF	
	
	lda		.p0SpriteColors,x												; Getting the sprite color
	sta		COLUP0															; Storing to the p1 color register
	
	lda		.p0Sprite,x														; Getting the graphics data
	sta		GRP0															; Saving to the player 1 graphics

	; 26 pixels left before visible

	sta		WSYNC															; Waiting for the next line

	lda		.fencePF0,x
	sta		PF0
	lda		.fencePF1,x
	sta		PF1
	sleep 11
	lda		#HOUSE_COLOR
	sta		COLUPF
	;lda		#HOUSE_WALL
	;sta		PF0
	;lda		#HOUSE_WALL2
	;sta		PF1
	
	sta		WSYNC															; Elongating the draw

	dex																		; Checking to see if we are done looping
	bpl		.p0DrawLoop
	
	lda		#FENCE_COLOR
	sta		COLUPF
	lda		.fencePF0,0														; Out of the loop, last byte
	sta		PF0
	lda		.fencePF1,0														; Out of the loop, last byte
	sta		PF1
	sleep 2
	lda		#HOUSE_COLOR
	sta		COLUPF
	sta		WSYNC															; Elongating the last draw
	dec		lineCount
	lda		#0
	sta		GRP0															; Turning off the player 0 graphics

	;------------------------------------------------
	; Ground Level
	;------------------------------------------------

	lda		#CANYON_GROUND_COLOR											; Color the canyon
	sta		COLUPF															; Send to TIA
	
	lda		#CANYON_GROUND
	sta		PF0																; PF the canyon ground
	sta		PF1																; PF the canyon ground
	sta		PF2																; PF the canyon ground
.ground	
	dec		lineCount														; Decrement lineCount
	dec		groundCount														; Decrement groundcount
	sta		WSYNC															; Draw line
	bne		.ground															; Loop back up 
	
	
;------------------------------------------------
; Overscan
;------------------------------------------------
	lda		#%01000010
	sta		VBLANK
    lda		#36
    sta		TIM64T

	lda #0																	; Turn off the pf in overscan
	sta	PF0
	sta	PF1
	sta	PF2
	sta	GRP0
	; NOTE SHOULDNT HAVE TO DO THE FOLLOWING TWO LINES.
	; TOP LINE OF BALL IS FOR SOME REASON GREEN, THIS MAKES IT BGCOLOR
	;lda		#BACKGROUND_COLOR
	;sta		COLUPF

	;***** Overscan Code goes here


	;------------------------------------------------
	; Player Collision Detection
	;------------------------------------------------
	;***** Playfield collision detection
	lda		#%10000000								; Loading the mask to check if p0 is colliding with the playfield
	bit		CXP0FB									; Comparing against the collision detection register
	beq		.noP0CollisionWithPlayField				; If they are equal, allow movement

	lda		#1										; Since there was a collision, set the collision flag
	sta		isP0PFCollision							; Setting the collision flag

	lda		#0
	sta 	p0CanMove								; Setting the can't move flag to help turn off input in a certain direction

	jmp		.doneWithPlayfieldCollisionDetection	

.noP0CollisionWithPlayField
	lda		#0										; Since there was no collision, clear the collision flag
	sta		isP0PFCollision

.doneWithPlayfieldCollisionDetection


.waitForOverscan
	lda     INTIM
	bne     .waitForOverscan

	jmp		MainLoop

;------------------------------------------------
; ROM Tables
;------------------------------------------------
	;***** ROM tables go here
	;***** Score Font
	ORG	$FA00
.zero_left
	.byte	%11100000
	.byte	%10100000
	.byte	%10100000
	.byte	%10100000
	.byte	%11100000

.one_left
	.byte	%01000000
	.byte	%11000000
	.byte	%01000000
	.byte	%01000000
	.byte	%11100000

.two_left
	.byte	%11100000
	.byte	%00100000
	.byte	%11100000
	.byte	%10000000
	.byte	%11100000

.three_left
	.byte	%11100000
	.byte	%00100000
